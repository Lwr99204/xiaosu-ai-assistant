# ═══════════════════════════════════════════════════════════════════════
# 小苏 · 公司内部 AI 助手 — 环境变量样例（FR-6-03）
#
# 用法：cp .env.example .env  →  填入真实值
# .env 已被 .gitignore 忽略；本文件**只放占位符，绝不放真实 key**
# （FR-6-04 是淘汰项，pre-commit 钩子会拦，见 scripts/dev/pre-commit）
#
# 字段与 backend/app/config.py 的 Settings 一一对应（TDD §4.1）。
# 全部经 pydantic-settings 强类型化，启动即校验：缺 key 直接启动失败并给出
# 明确报错，而不是运行到一半 500（FR-6-02）。
# ═══════════════════════════════════════════════════════════════════════


# ── LLM（Chat 供应商，OpenAI 兼容协议）──────────────────────────────────
# openai_compat = 真实供应商；mock = 离线测试用 MockLLMProvider
LLM_PROVIDER=openai_compat

# 🔴 必填。SecretStr 类型，repr/日志中自动显示 **********
LLM_API_KEY=sk-your-api-key-here

# 阿里云 MaaS token-plan 端点（TDD §1.3 实测：chat / tool_call / stream 三项均 200）
# ⚠️ 这把 key 是 token-plan 专用，**不能**跨端点复用（打标准 dashscope 返回 401）
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 默认模型。同一把 key 实测可用的备选（M11「多模型适配」零成本达成）：
#   qwen3.8-flash     —— 更快更省，适合验收题批量跑
#   deepseek-v4-pro   —— 另一家供应商，用于交叉验证
#   glm-5.3           —— 同上
# ⚠️ qwen3.8-max 是**推理模型**，响应携带 reasoning_content，且流式下
#    reasoning chunk **先于** content 到达（TDD §1.3 坑 1 / R14）
LLM_MODEL=qwen3.8-max

LLM_TEMPERATURE=0.1          # 问答场景压低随机性
LLM_TIMEOUT_S=30.0
LLM_MAX_RETRIES=2            # 仅对超时/5xx/429 重试，4xx 直接抛（FR-6-07/08）


# ── Embedding（本地 BGE-M3 独立服务，TDD §1.4）─────────────────────────
# 🔴 与 chat 的 base_url **必须分开**：chat 走云端 token-plan，embed 走本地。
#    实测该云端端点不提供任何 embedding 模型（/embeddings 三个模型名全 404）。
# 启动前先跑：python backend/dev_tools/embedding_service.py
EMBED_BASE_URL=http://127.0.0.1:8001/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024               # 实测值。改动必须重建索引（R8）
EMBED_BATCH_SIZE=16          # 实测批量 4 条 278ms(GPU)
EMBED_API_KEY=not-needed     # 本地服务不校验，但 OpenAI 客户端要求非空
EMBED_TIMEOUT_S=60.0         # 首次请求含 CUDA 预热（实测 2.1s），留足余量


# ── RAG ────────────────────────────────────────────────────────────────
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_CHARS=80
RETRIEVAL_TOP_K=8

# 拒答阈值（FR-2-09）🔴 实测标定：不相关中文噪声地板 ≈0.48、正确命中 ≈0.71。
# 原设计的 0.35 **低于噪声地板 = 完全不过滤**，拒答 L1 层形同虚设（§1.4 / R16）。
# 0.55 仅为起点，最终以 M3 的 backend/dev_tools/calibrate_threshold.py 标定结果为准。
RETRIEVAL_MIN_SCORE=0.55


# ── Agent ──────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_ROUNDS=5      # Function Calling 最大轮次（FR-3-06），超出则降级
AGENT_HISTORY_MAX_TURNS=10   # 多轮上下文保留轮数（FR-2-06）


# ── 存储 ───────────────────────────────────────────────────────────────
# 全部为运行时产物目录，已在 .gitignore 中排除
STORAGE_DIR=storage
SQLITE_PATH=storage/xiaosu.db
CHROMA_DIR=storage/chroma
LOG_DIR=logs


# ── IM：企业微信「智能机器人」长连接（TDD §1.5，M9 主平台）──────────────
# 无凭证时保持 false，项目其余部分照常运行，**不被 IM 阻塞开发**
WECOM_ENABLED=false

# 管理后台 →「智能机器人」→ 创建后获取（注意：**不是**自建应用的
# corpid/corpsecret/agentid，也**不是**钉钉的 AppKey/AppSecret/RobotCode）
# 🔴 secret 只显示一次，创建后立即复制；等同密码，只写进本地 .env
WECOM_BOT_ID=your-wecom-bot-id
WECOM_BOT_SECRET=your-wecom-bot-secret

# 出向网关，主动连接 → 无需公网 IP / 域名 / 备案 / 内网穿透
WECOM_WS_URL=wss://openws.work.weixin.qq.com

# userid 白名单，🔴 强烈建议配置：为空意味着企业内任何人都能调用机器人、
# 烧你的 token 配额。wecom_enabled=true 且白名单为空时启动会打 WARNING。
# ⚠️ pydantic-settings 对 list[str] 按 **JSON 数组**解析，不是逗号分隔：
WECOM_ALLOWED_USER_IDS=[]
# 示例：WECOM_ALLOWED_USER_IDS=["ZhangSan","LiSi"]

# 单条消息长度上限，超出由 im/formatter.py 在**引用条目边界**分段（不硬截断）
WECOM_MAX_REPLY_CHARS=4000

# 流式回写攒批粒度：攒够 40 字符**或** ≥300ms 就推一次（取先到者）。
# 🔴 禁止逐 token 调用 reply_stream —— 会打爆网关频率限制（TDD §4.6.3）
IM_STREAM_CHUNK_CHARS=40
IM_REPLY_TIMEOUT_S=60.0      # 硬超时兜底，超时主动发提示（FR-4-09）


# ── 内部 Mock API ──────────────────────────────────────────────────────
MOCK_DATA_DIR=data/mock
