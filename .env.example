# 小苏环境变量示例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交真实密钥。

# LLM（OpenAI 兼容协议）
LLM_PROVIDER=openai_compat
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-chat-model
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Embedding。本地模型权重不入库；此处为示例占位路径，请改成目标机器上的模型目录。
# 例如 Windows: E:/Models/bge-m3。标准 PyTorch 权重需使用安装了
# sentence-transformers 的独立 Python；留空时启动脚本会自动探测 backend/.venv-embedding。
BGE_MODEL_DIR=E:/path/to/bge-m3
BGE_PYTHON=
BGE_PORT=8001
EMBED_BASE_URL=http://127.0.0.1:8001/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16
EMBED_API_KEY=not-needed
EMBED_TIMEOUT_S=60

# RAG / Agent
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_CHARS=80
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.63
RETRIEVAL_MIN_SPREAD=0.01
AGENT_MAX_TOOL_ROUNDS=5
AGENT_HISTORY_MAX_TURNS=10

# 运行时数据目录
STORAGE_DIR=storage
SQLITE_PATH=storage/xiaosu.db
CHROMA_DIR=storage/chroma
LOG_DIR=logs
MOCK_DATA_DIR=data/mock

# 企业微信智能机器人长连接
# Gate 0 只验证真实消息收发；凭证只能写进本地 .env。
WECOM_ENABLED=false
WECOM_BOT_ID=your-wecom-bot-id
WECOM_BOT_SECRET=your-wecom-bot-secret
WECOM_WS_URL=wss://openws.work.weixin.qq.com
WECOM_ALLOWED_USER_IDS=[]
WECOM_MAX_REPLY_CHARS=4000
IM_STREAM_CHUNK_CHARS=40
IM_REPLY_TIMEOUT_S=60

# 本地服务端口（避开常见占用端口）
BACKEND_PORT=8010
FRONTEND_PORT=3001

# Web 管理后台（Next.js 服务端代理目标）
BACKEND_URL=http://127.0.0.1:8010
