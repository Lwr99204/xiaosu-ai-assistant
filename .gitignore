# ═══════════════════════════════════════════════════════════════════════
# 小苏 · 公司内部 AI 助手 — .gitignore（FR-6-18）
# 三条硬约束：① 密钥永不入库（FR-6-04 淘汰项）② 日志不入库（FR-6-05）
#            ③ 虚拟环境 / 依赖 / 构建产物不入库
# ═══════════════════════════════════════════════════════════════════════

# ── 密钥与环境变量 ──────────────────────────────────────────────
# .env 含 LLM_API_KEY / WECOM_BOT_SECRET，一旦入库即触发淘汰项
.env
.env.*
!.env.example
*.pem
*.key

# ── Python（uv 管理的虚拟环境名强制为 .venv）────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.uv-cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── Node / Next.js（pnpm）───────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# ── 运行时产物 ──────────────────────────────────────────────────
# logs/ 目录本身入库（FR-6-05 要求日志落地可查），但日志内容不入库
logs/*
!logs/.gitkeep
# storage/ 存 SQLite 库文件、Chroma 持久化目录与上传原件，全部为运行时产物
storage/
*.db
*.db-wal
*.db-shm
*.sqlite3

# ── 大文件：模型权重（2.2 GB，见 backend/dev_tools/README.md）────
*.bin
*.safetensors
*.onnx
*.gguf

# ── 系统与编辑器 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
